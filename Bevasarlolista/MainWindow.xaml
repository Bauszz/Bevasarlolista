<Window x:Class="Bevasarlolista.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Bevasarlolista"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="400">
    <Grid>
        <ListBox x:Name="LB_bevásárló" Width="200" Height="250" HorizontalAlignment="Left" Margin="20"/>
        <TextBox x:Name="TB_input" HorizontalAlignment="Left" Margin="20,360,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" KeyDown="OnKeyDownHandler"/>
        <Button x:Name="BTN_add" Content="Hozzáadás" HorizontalAlignment="Left" Margin="159,358,0,0" VerticalAlignment="Top" Click="Add" ClickMode="Press"/>
        <Button x:Name="BTN_assasination" Content="Kijelölt törlés" HorizontalAlignment="Left" Margin="247,92,0,0" VerticalAlignment="Top" Height="109" Width="91" Click="KILL" ClickMode="Press"/>
        <Button x:Name="BTN_massecre" Content="MINDEN TÖRLÉSE" HorizontalAlignment="Left" Margin="247,233,0,0" VerticalAlignment="Top" Height="109" Width="91" Click="Murder" ClickMode="Press"/>
        <Label x:Name="L_itemcount" Content="Tárgyak száma:" HorizontalAlignment="Left" Margin="101,61,0,0" VerticalAlignment="Top" Width="88"/>
    </Grid>
</Window>
